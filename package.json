{
  "name": "szfisher",
  "private": true,
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:admin": "playwright test",
    "test:admin:install": "playwright install chromium",
    "build": "pnpm -r build",
    "db:up": "docker compose -f infra/docker/docker-compose.yml up -d postgres",
    "db:down": "docker compose -f infra/docker/docker-compose.yml down",
    "db:migrate": "pnpm --filter @szfisher/api exec prisma migrate deploy",
    "db:seed": "pnpm --filter @szfisher/api prisma:seed",
    "db:test:up": "docker compose -f infra/docker/docker-compose.test.yml up -d",
    "db:test:down": "docker compose -f infra/docker/docker-compose.test.yml down",
    "db:test:prepare": "pnpm --filter @szfisher/api prisma:test:prepare",
    "test:integration": "pnpm db:test:prepare && pnpm --filter @szfisher/api test:e2e",
    "openapi:check": "bash scripts/check-openapi.sh",
    "dev:api": "pnpm --filter @szfisher/api dev",
    "dev:admin": "pnpm --filter @szfisher/admin dev"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "jest": "30.5.2",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "argon2",
      "esbuild",
      "prisma",
      "sharp"
    ],
    "overrides": {
      "deepmerge-ts": "8.0.2",
      "effect": "3.22.1",
      "glob": "14.0.2",
      "minimatch": "11.0.1",
      "uuid": "11.1.1"
    }
  }
}
