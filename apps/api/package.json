{
  "name": "@szfisher/api",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "dev": "nest start --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --passWithNoTests --testMatch \"**/src/**/*.spec.ts\"",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand --config jest.config.cjs",
    "build": "prisma generate && nest build",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "prisma:test:prepare": "node scripts/prepare-test-database.mjs",
    "poi:sync": "tsx src/jobs/sync-pois.job.ts",
    "poi:sync:prod": "node dist/jobs/sync-pois.job.js",
    "analytics:purge": "tsx src/jobs/purge-analytics.job.ts",
    "analytics:purge:prod": "node dist/jobs/purge-analytics.job.js",
    "perf:seed": "tsx scripts/seed-performance-data.ts",
    "quality:report": "tsx scripts/spot-quality-report.ts",
    "openapi:generate": "tsc -p tsconfig.openapi.json && tsx dist/openapi/scripts/generate-openapi.js && openapi-typescript ../../openapi/openapi.yaml -o ../../packages/api-client/src/schema.d.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.10",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.10",
    "@nestjs/platform-express": "11.2.10",
    "@nestjs/swagger": "11.4.8",
    "@prisma/client": "6.19.3",
    "@szfisher/shared": "workspace:*",
    "ali-oss": "6.23.0",
    "argon2": "0.45.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "exceljs": "4.4.0",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "otplib": "13.6.0",
    "prisma": "6.19.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "ulid": "3.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.13",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "24.19.2",
    "@types/supertest": "7.2.1",
    "openapi-typescript": "7.13.0",
    "supertest": "7.3.2",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  }
}
