.create-page {
  padding-bottom: 60rpx;
}

.create-card {
  padding: 26rpx 24rpx;
}

.spot-line {
  display: flex;
  gap: 16rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #e7ede8;
  font-size: 27rpx;
}

.spot-label {
  flex: 0 0 auto;
  color: #7a8782;
}

.spot-name {
  flex: 1;
  min-width: 0;
  color: #13211c;
  font-weight: 600;
}

.type-tabs {
  display: flex;
  gap: 12rpx;
  margin: 22rpx 0 24rpx;
}

.type-tab {
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  background: #eef2ee;
  color: #5e6b66;
  font-size: 25rpx;
}

.type-tab.is-active {
  background: #0e6b5e;
  color: #ffffff;
}

.picker-value {
  min-height: 60rpx;
  line-height: 1.5;
}

.picker-placeholder {
  color: #8a9691;
}

.catch-hint {
  display: block;
  margin-top: 8rpx;
}

.terms-row {
  margin-top: 8rpx;
}

.terms-label {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #4c5b55;
  font-size: 24rpx;
  line-height: 1.5;
}

.terms-text {
  flex: 1;
}

.terms-label checkbox {
  transform: scale(0.85);
}

.create-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.create-actions .secondary-button {
  flex: 0 0 220rpx;
}

.publish-button {
  flex: 1;
}
