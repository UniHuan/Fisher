.create-page {
  padding: 24rpx 24rpx 240rpx;
}

.create-intro {
  padding: 8rpx 6rpx 24rpx;
}

.create-kicker {
  display: block;
  color: #0e6b5e;
  font-size: 22rpx;
  letter-spacing: 0.14em;
}

.create-title {
  display: block;
  margin-top: 8rpx;
  color: #13211c;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: -0.02em;
}

.spot-chip {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 16rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #eef4f0;
}

.spot-chip-label {
  color: #0e6b5e;
  font-size: 21rpx;
}

.spot-chip-name {
  color: #13211c;
  font-size: 23rpx;
  font-weight: 600;
}

.create-section {
  margin-bottom: 20rpx;
  padding: 26rpx 24rpx;
  border: 1rpx solid #e3ebe6;
  border-radius: 18rpx;
  background: #ffffff;
}

.section-label {
  color: #13211c;
  font-size: 26rpx;
  font-weight: 600;
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.section-meta {
  color: #8a9691;
  font-size: 22rpx;
}

.section-hint {
  display: block;
  margin-top: 12rpx;
  color: #8a9691;
  font-size: 22rpx;
  line-height: 1.6;
}

.type-grid {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.type-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 6rpx;
  padding: 20rpx 18rpx;
  border: 2rpx solid #e3ebe6;
  border-radius: 14rpx;
  background: #f8faf7;
}

.type-card.is-active {
  border-color: #0e6b5e;
  background: #eef6f2;
}

.type-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #e3eee8;
  color: #0e6b5e;
  font-size: 24rpx;
  font-weight: 600;
}

.type-card.is-active .type-mark {
  background: #0e6b5e;
  color: #ffffff;
}

.type-name {
  color: #13211c;
  font-size: 26rpx;
  font-weight: 600;
}

.type-desc {
  color: #8a9691;
  font-size: 20rpx;
  line-height: 1.4;
}

.content-textarea {
  width: 100%;
  min-height: 260rpx;
  margin-top: 12rpx;
  padding: 20rpx;
  box-sizing: border-box;
  border: 1rpx solid #e3ebe6;
  border-radius: 12rpx;
  background: #f8faf7;
  color: #13211c;
  font-size: 27rpx;
  line-height: 1.7;
}

.field-grid {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.field-block {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.field-label {
  color: #5e6b66;
  font-size: 22rpx;
}

.field-control {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 76rpx;
  padding: 0 18rpx;
  box-sizing: border-box;
  border: 1rpx solid #e3ebe6;
  border-radius: 12rpx;
  background: #f8faf7;
  color: #13211c;
  font-size: 26rpx;
}

.field-placeholder {
  color: #8a9691;
}

.catch-hint {
  color: #b2412a;
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.image-cell {
  position: relative;
  width: 152rpx;
  height: 152rpx;
}

.image-thumb {
  width: 152rpx;
  height: 152rpx;
  border-radius: 12rpx;
  background: #e7ede8;
}

.image-remove {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #0b2b26;
  color: #ffffff;
  font-size: 26rpx;
  line-height: 36rpx;
  text-align: center;
}

.image-progress {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: rgba(11, 43, 38, 0.55);
}

.image-progress-text {
  color: #ffffff;
  font-size: 22rpx;
}

.image-add {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 152rpx;
  height: 152rpx;
  border: 1rpx dashed #cfdcd4;
  border-radius: 12rpx;
  background: #f2f5f0;
}

.image-add-icon {
  color: #7a8782;
  font-size: 48rpx;
  line-height: 1;
}

.upload-hint {
  color: #0e6b5e;
}

.terms-card {
  margin-bottom: 20rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid #e3ebe6;
  border-radius: 16rpx;
  background: #ffffff;
}

.terms-label {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  color: #4c5b55;
  font-size: 24rpx;
  line-height: 1.5;
}

.terms-label checkbox {
  transform: scale(0.85);
}

.terms-text {
  color: #4c5b55;
}

.terms-link {
  color: #0e6b5e;
}

.terms-links {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 10rpx;
  padding-left: 44rpx;
}

.terms-aux {
  color: #8a9691;
  font-size: 21rpx;
}

.terms-dot {
  color: #cfdcd4;
  font-size: 20rpx;
}

.legal-note {
  display: block;
  margin-top: 8rpx;
  padding-left: 44rpx;
  color: #a3ada8;
  font-size: 20rpx;
}

.create-actions {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  padding: 16rpx 24rpx 16rpx;
  padding-bottom: calc(16rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #e3ebe6;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -12rpx 30rpx rgba(11, 43, 38, 0.06);
}

.publish-note {
  display: block;
  margin-bottom: 12rpx;
  text-align: center;
  color: #8a9691;
  font-size: 21rpx;
}

.action-row {
  display: flex;
  gap: 16rpx;
}

.cancel-button {
  flex: 0 0 200rpx;
  height: 88rpx;
  padding: 0;
  border: 1rpx solid #d8e2dc;
  border-radius: 14rpx;
  background: #ffffff;
  color: #4c5b55;
  font-size: 27rpx;
  line-height: 86rpx;
}

.cancel-button::after {
  border: 0;
}

.publish-button {
  flex: 1;
  height: 88rpx;
  padding: 0;
  border: 0;
  border-radius: 14rpx;
  background: #0e6b5e;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 88rpx;
}

.publish-button[disabled] {
  background: #a9c3bb;
  color: #f4f7f4;
}

.publish-button::after {
  border: 0;
}
