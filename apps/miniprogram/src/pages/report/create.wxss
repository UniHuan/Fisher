.create-page {
  padding: 24rpx 24rpx 240rpx;
}

.create-intro {
  padding: 8rpx 6rpx 24rpx;
}

.create-kicker {
  display: block;
  color: #1E6B57;
  font-size: 24rpx;
  letter-spacing: 0.14em;
}

.create-title {
  display: block;
  margin-top: 8rpx;
  color: #1B2420;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: -0.02em;
}

.spot-chip {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 16rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #EDF2EC;
}

.spot-chip-label {
  color: #1E6B57;
  font-size: 24rpx;
}

.spot-chip-name {
  color: #1B2420;
  font-size: 23rpx;
  font-weight: 600;
}

.create-section {
  margin-bottom: 20rpx;
  padding: 26rpx 24rpx;
  border: 1rpx solid #E1E6DE;
  border-radius: 18rpx;
  background: #ffffff;
}

.section-label {
  color: #1B2420;
  font-size: 26rpx;
  font-weight: 600;
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.section-meta {
  color: #6B7772;
  font-size: 24rpx;
}

.section-hint {
  display: block;
  margin-top: 12rpx;
  color: #6B7772;
  font-size: 24rpx;
  line-height: 1.6;
}

.type-grid {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.type-card {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 6rpx;
  padding: 20rpx 18rpx;
  border: 2rpx solid #E1E6DE;
  border-radius: 14rpx;
  background: #F8FAF5;
}

.type-card.is-active {
  border-color: #1E6B57;
  background: #EDF3EC;
}

.type-mark {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #E3EEE6;
  color: #1E6B57;
  font-size: 24rpx;
  font-weight: 600;
}

.type-card.is-active .type-mark {
  background: #1E6B57;
  color: #ffffff;
}

.type-name {
  color: #1B2420;
  font-size: 26rpx;
  font-weight: 600;
}

.type-desc {
  color: #6B7772;
  font-size: 24rpx;
  line-height: 1.4;
}

.content-textarea {
  width: 100%;
  min-height: 260rpx;
  margin-top: 12rpx;
  padding: 20rpx;
  box-sizing: border-box;
  border: 1rpx solid #E1E6DE;
  border-radius: 12rpx;
  background: #F8FAF5;
  color: #1B2420;
  font-size: 27rpx;
  line-height: 1.7;
}

.field-grid {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.field-block {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.field-label {
  color: #5C6B64;
  font-size: 24rpx;
}

.field-control {
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 76rpx;
  padding: 0 18rpx;
  box-sizing: border-box;
  border: 1rpx solid #E1E6DE;
  border-radius: 12rpx;
  background: #F8FAF5;
  color: #1B2420;
  font-size: 26rpx;
}

.field-placeholder {
  color: #6B7772;
}

.catch-hint {
  color: #A93226;
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.image-cell {
  position: relative;
  width: 152rpx;
  height: 152rpx;
}

.image-thumb {
  width: 152rpx;
  height: 152rpx;
  border-radius: 12rpx;
  background: #E3E8E1;
}

.image-remove {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #123B32;
  color: #ffffff;
  font-size: 30rpx;
  line-height: 56rpx;
  text-align: center;
}

.image-progress {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: rgba(11, 43, 38, 0.55);
}

.image-progress-text {
  color: #ffffff;
  font-size: 24rpx;
}

.image-add {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 152rpx;
  height: 152rpx;
  border: 1rpx dashed #D2DAD2;
  border-radius: 12rpx;
  background: #F2F5EF;
}

.image-add-icon {
  color: #6B7772;
  font-size: 48rpx;
  line-height: 1;
}

.upload-hint {
  color: #1E6B57;
}

.terms-card {
  margin-bottom: 20rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid #E1E6DE;
  border-radius: 16rpx;
  background: #ffffff;
}

.terms-label {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  color: #4C5B54;
  font-size: 24rpx;
  line-height: 1.5;
}

.terms-label checkbox {
  transform: scale(0.85);
}

.terms-text {
  color: #4C5B54;
}

.terms-link {
  color: #1E6B57;
}

.terms-links {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 10rpx;
  padding-left: 44rpx;
}

.terms-aux {
  color: #6B7772;
  font-size: 24rpx;
}

.terms-dot {
  color: #D2DAD2;
  font-size: 20rpx;
}

.legal-note {
  display: block;
  margin-top: 8rpx;
  padding-left: 44rpx;
  color: #6B7772;
  font-size: 24rpx;
}

.feedback-link {
  display: block;
  margin: 4rpx 0 20rpx;
  padding: 6rpx 0;
  color: #1E6B57;
  font-size: 24rpx;
  text-align: center;
  text-decoration: underline;
}

.create-actions {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  padding: 16rpx 24rpx 16rpx;
  padding-bottom: calc(16rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #E1E6DE;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -12rpx 30rpx rgba(11, 43, 38, 0.06);
}

.publish-note {
  display: block;
  margin-bottom: 12rpx;
  text-align: center;
  color: #6B7772;
  font-size: 24rpx;
}

.action-row {
  display: flex;
  gap: 16rpx;
}

.cancel-button {
  flex: 0 0 200rpx;
  height: 88rpx;
  padding: 0;
  border: 1rpx solid #D8DFD8;
  border-radius: 14rpx;
  background: #ffffff;
  color: #4C5B54;
  font-size: 27rpx;
  line-height: 86rpx;
}

.cancel-button::after {
  border: 0;
}

.publish-button {
  flex: 1;
  height: 88rpx;
  padding: 0;
  border: 0;
  border-radius: 14rpx;
  background: #1E6B57;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 88rpx;
}

.publish-button[disabled] {
  background: #A9BDB4;
  color: #F4F7F1;
}

.publish-button::after {
  border: 0;
}
