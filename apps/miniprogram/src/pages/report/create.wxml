<view class="page create-page">
  <view wx:if="{{loadingConfig}}" class="empty">正在加载发布配置…</view>

  <view wx:elif="{{configError}}" class="card empty">
    <text>{{configError}}</text>
    <button class="primary-button retry-button" bindtap="retryConfig">重新加载</button>
  </view>

  <view wx:elif="{{!ugcEnabled}}" class="card empty">社区功能暂未开放</view>

  <view wx:elif="{{!sessionReady}}" class="card login-card">
    <text class="login-title">登录后发布</text>
    <text class="login-text">使用微信登录后可以发布评论、鱼获和情报。</text>
    <text class="login-text">登录仅获取微信身份标识，不读取昵称、头像和手机号。</text>
    <button
      class="primary-button login-button"
      bindtap="login"
      loading="{{loggingIn}}"
      disabled="{{loggingIn}}"
    >{{loggingIn ? '正在登录' : '微信登录'}}</button>
  </view>

  <block wx:else>
    <view class="create-intro">
      <text class="create-kicker">钓友情报</text>
      <text class="create-title">分享这次的情况</text>
      <view class="spot-chip">
        <text class="spot-chip-label">钓点</text>
        <text class="spot-chip-name">{{spotName || '当前钓点'}}</text>
      </view>
    </view>

    <view class="create-section">
      <text class="section-label">类型</text>
      <view class="type-grid">
        <view
          wx:for="{{contentTypes}}"
          wx:key="key"
          class="type-card {{contentType === item.key ? 'is-active' : ''}}"
          data-type="{{item.key}}"
          bindtap="selectType"
        >
          <view class="type-mark">{{item.mark}}</view>
          <text class="type-name">{{item.label}}</text>
          <text class="type-desc">{{item.desc}}</text>
        </view>
      </view>
    </view>

    <view class="create-section">
      <view class="section-head">
        <text class="section-label">正文</text>
        <text class="section-meta">{{contentCount}}/{{maxContentLength}}</text>
      </view>
      <textarea
        class="content-textarea"
        value="{{content}}"
        placeholder="说说这次的情况..."
        maxlength="500"
        bindinput="onContentInput"
      />
      <text class="section-hint">写清楚时间、鱼情和注意事项，1 到 500 字。</text>
    </view>

    <view class="create-section">
      <view class="section-head">
        <text class="section-label">图片</text>
        <text class="section-meta">{{images.length}}/{{maxImages}}</text>
      </view>
      <view class="image-grid">
        <view wx:for="{{images}}" wx:key="path" class="image-cell">
          <image
            class="image-thumb"
            src="{{item.path}}"
            mode="aspectFill"
            data-index="{{index}}"
            bindtap="previewDraftImage"
          />
          <view wx:if="{{submitting && item.progress < 100}}" class="image-progress">
            <text class="image-progress-text">{{item.progress}}%</text>
          </view>
          <view class="image-remove" data-index="{{index}}" catchtap="removeImage">×</view>
        </view>
        <view wx:if="{{images.length < maxImages}}" class="image-add" bindtap="chooseImages">
          <text class="image-add-icon">＋</text>
        </view>
      </view>
      <text class="section-hint">选填，最多 6 张，发布前会逐张上传并审核。</text>
      <text wx:if="{{submitting && images.length > 0}}" class="section-hint upload-hint">
        正在逐张上传图片，全部成功后才会发布
      </text>
    </view>

    <view wx:if="{{contentType === 'catch'}}" class="create-section">
      <text class="section-label">鱼获信息</text>
      <view class="field-grid">
        <view class="field-block">
          <text class="field-label">鱼种</text>
          <picker
            mode="selector"
            range="{{fishLabels}}"
            value="{{fishIndex}}"
            bindchange="onFishChange"
          >
            <view class="field-control {{fishKey ? '' : 'field-placeholder'}}">{{fishLabel || '请选择鱼种'}}</view>
          </picker>
        </view>
        <view class="field-block">
          <text class="field-label">重量（公斤，选填）</text>
          <input
            class="field-control"
            type="digit"
            value="{{weight}}"
            placeholder="例如 2.5"
            bindinput="onWeightInput"
          />
        </view>
      </view>
      <text wx:if="{{!fishKey}}" class="section-hint catch-hint">发布鱼获需要选择鱼种</text>
    </view>

    <view class="terms-card">
      <checkbox-group bindchange="onTermsChange">
        <label class="terms-label">
          <checkbox value="terms" checked="{{termsAccepted}}" color="#0e6b5e" />
          <text class="terms-text">我已阅读并同意</text>
          <text class="terms-link" data-key="community" catchtap="openLegal">社区规范</text>
        </label>
      </checkbox-group>
      <view class="terms-links">
        <text class="terms-aux" data-key="terms" bindtap="openLegal">用户协议</text>
        <text class="terms-dot">·</text>
        <text class="terms-aux" data-key="privacy" bindtap="openLegal">隐私政策</text>
      </view>
      <text wx:if="{{legalNote}}" class="legal-note">{{legalNote}}</text>
    </view>

    <view wx:if="{{!meCanPublish}}" class="form-error">
      {{restrictionText || '当前账号暂不能发布内容'}}
    </view>
    <view wx:if="{{submitError}}" class="form-error">{{submitError}}</view>

    <view class="create-actions">
      <text class="publish-note">发布后先审核，通过后会出现在钓点详情页</text>
      <view class="action-row">
        <button class="cancel-button" bindtap="cancel" disabled="{{submitting}}">取消</button>
        <button
          class="publish-button"
          bindtap="submit"
          loading="{{submitting}}"
          disabled="{{submitting || !meCanPublish}}"
        >发布</button>
      </view>
    </view>
  </block>
</view>
