.legal-fallback {
  padding: 40rpx 28rpx;
  text-align: center;
}

.legal-fallback-title {
  display: block;
  color: #1B2420;
  font-size: 32rpx;
  font-weight: 600;
}

.legal-fallback-text {
  display: block;
  margin-top: 14rpx;
  color: #5C6B64;
  font-size: 25rpx;
  line-height: 1.6;
}

.legal-fallback-url {
  display: block;
  margin-top: 18rpx;
  color: #1E6B57;
  font-size: 23rpx;
  line-height: 1.5;
  word-break: break-all;
}

.legal-copy {
  margin-top: 28rpx;
}

.legal-retry {
  margin-top: 16rpx;
}
