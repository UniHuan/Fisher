.feedback-page {
  padding: 24rpx 24rpx 220rpx;
}

.feedback-intro {
  padding: 8rpx 6rpx 24rpx;
}

.feedback-kicker {
  display: block;
  color: #1E6B57;
  font-size: 22rpx;
  letter-spacing: 0.14em;
}

.feedback-title {
  display: block;
  margin-top: 8rpx;
  color: #1B2420;
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: -0.02em;
}

.spot-chip {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 16rpx;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #EDF2EC;
}

.spot-chip-label {
  color: #1E6B57;
  font-size: 21rpx;
}

.spot-chip-name {
  color: #1B2420;
  font-size: 23rpx;
  font-weight: 600;
}

.feedback-section {
  margin-bottom: 20rpx;
  padding: 26rpx 24rpx;
  border: 1rpx solid #E1E6DE;
  border-radius: 16rpx;
  background: #ffffff;
}

.section-label {
  color: #1B2420;
  font-size: 26rpx;
  font-weight: 600;
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 14rpx;
}

.section-meta {
  color: #6B7772;
  font-size: 22rpx;
}

.section-hint {
  display: block;
  margin-top: 12rpx;
  color: #6B7772;
  font-size: 22rpx;
  line-height: 1.6;
}

.category-scroll {
  margin-top: 16rpx;
  white-space: nowrap;
}

.category-chip {
  display: inline-flex;
  align-items: center;
  margin-right: 12rpx;
  padding: 14rpx 30rpx;
  border: 2rpx solid #E1E6DE;
  border-radius: 999rpx;
  background: #F8FAF5;
  color: #1B2420;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1.3;
}

.category-chip:last-child {
  margin-right: 0;
}

.category-chip.is-active {
  border-color: #1E6B57;
  background: #1E6B57;
  color: #ffffff;
}

.category-hint {
  display: block;
  margin-top: 12rpx;
  color: #6B7772;
  font-size: 22rpx;
  line-height: 1.5;
}

.content-textarea {
  width: 100%;
  min-height: 260rpx;
  padding: 20rpx;
  box-sizing: border-box;
  border: 1rpx solid #E1E6DE;
  border-radius: 12rpx;
  background: #F8FAF5;
  color: #1B2420;
  font-size: 27rpx;
  line-height: 1.7;
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.image-cell {
  position: relative;
  width: 152rpx;
  height: 152rpx;
}

.image-thumb {
  width: 152rpx;
  height: 152rpx;
  border-radius: 12rpx;
  background: #E3E8E1;
}

.image-remove {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: #123B32;
  color: #ffffff;
  font-size: 26rpx;
  line-height: 36rpx;
  text-align: center;
}

.image-progress {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  background: rgba(11, 43, 38, 0.55);
}

.image-progress-text {
  color: #ffffff;
  font-size: 22rpx;
}

.image-add {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 152rpx;
  height: 152rpx;
  border: 1rpx dashed #D2DAD2;
  border-radius: 12rpx;
  background: #F2F5EF;
}

.image-add-icon {
  color: #6B7772;
  font-size: 48rpx;
  line-height: 1;
}

.upload-hint {
  color: #1E6B57;
}

.consent-card {
  margin-bottom: 20rpx;
  padding: 22rpx 24rpx;
  border: 1rpx solid #CBDCD3;
  border-radius: 16rpx;
  background: #EDF3EC;
}

.consent-label {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  color: #1B2420;
  font-size: 24rpx;
  line-height: 1.6;
}

.consent-label checkbox {
  transform: scale(0.85);
}

.consent-text {
  flex: 1;
  min-width: 0;
}

.consent-hint {
  display: block;
  margin-top: 8rpx;
  padding-left: 44rpx;
  color: #5C6B64;
  font-size: 21rpx;
  line-height: 1.5;
}

.contact-input {
  width: 100%;
  padding: 18rpx 20rpx;
  box-sizing: border-box;
  border: 1rpx solid #E1E6DE;
  border-radius: 12rpx;
  background: #F8FAF5;
  color: #1B2420;
  font-size: 27rpx;
}

.feedback-actions {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #E1E6DE;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -12rpx 30rpx rgba(11, 43, 38, 0.06);
}

.privacy-note {
  display: block;
  margin-bottom: 12rpx;
  text-align: center;
  color: #6B7772;
  font-size: 21rpx;
}

.submit-button {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.submit-button[disabled] {
  background: #A9BDB4;
  color: #F4F7F1;
}
