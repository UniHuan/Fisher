<view wx:if="{{loading}}" class="empty">正在加载钓点…</view>

<view wx:elif="{{error}}" class="page">
  <view class="card empty">
    <text>{{error}}</text>
    <button class="primary-button detail-retry" bindtap="retry">重试</button>
  </view>
</view>

<view wx:elif="{{spot}}" class="detail-page">
  <view wx:if="{{images.length}}" class="gallery">
    <swiper class="gallery-swiper" indicator-dots circular>
      <swiper-item wx:for="{{images}}" wx:key="*this">
        <image
          class="gallery-image"
          src="{{item}}"
          mode="aspectFill"
          data-index="{{index}}"
          bindtap="previewImage"
        />
      </swiper-item>
    </swiper>
  </view>
  <view wx:else class="gallery gallery-empty">
    <view class="gallery-placeholder">
      <view class="gallery-placeholder-mark">钓</view>
      <text class="gallery-placeholder-text">实景图待补充</text>
    </view>
  </view>

  <view class="detail-body">
    <view class="detail-heading">
      <text class="detail-title">{{spot.spot_name}}</text>
      <view class="tag-row">
        <text class="tag">{{spot.district || '区域未填'}}</text>
        <text wx:if="{{spot.is_core}}" class="tag tag-core">核心</text>
        <text class="tag {{openTone || 'tag-line'}}">{{openLabel}}</text>
        <text class="tag">{{feeLabel}}</text>
      </view>
    </view>

    <view wx:if="{{spot.is_banned}}" class="alert alert-danger">
      该水域为禁钓区，请勿垂钓。{{spot.ban_note || ''}}
    </view>
    <view wx:elif="{{spot.open_status === 'paused'}}" class="alert alert-warn">
      该钓点暂停开放，出发前请通过官方渠道确认。
    </view>
    <view wx:if="{{freshnessText}}" class="alert {{freshnessTone === 'tag-danger' ? 'alert-danger' : 'alert-warn'}}">
      {{freshnessText}}，建议出发前确认。
    </view>

    <view wx:if="{{markers.length}}" class="map-preview card">
      <map
        class="map-preview-map"
        latitude="{{markers[0].latitude}}"
        longitude="{{markers[0].longitude}}"
        scale="15"
        markers="{{markers}}"
      />
    </view>

    <view class="info-card card">
      <view class="info-row">
        <text class="info-label">地址</text>
        <text class="info-value">{{spot.address || '暂无地址'}}</text>
      </view>
      <view wx:if="{{waterLabel}}" class="info-row">
        <text class="info-label">水域</text>
        <text class="info-value">{{waterLabel}}</text>
      </view>
      <view wx:if="{{venueLabel}}" class="info-row">
        <text class="info-label">场所</text>
        <text class="info-value">{{venueLabel}}</text>
      </view>
      <view wx:if="{{methodText}}" class="info-row">
        <text class="info-label">钓法</text>
        <text class="info-value">{{methodText}}</text>
      </view>
      <view wx:if="{{spot.open_hours}}" class="info-row">
        <text class="info-label">开放时间</text>
        <text class="info-value">{{spot.open_hours}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">收费</text>
        <text class="info-value">{{feeText}}</text>
      </view>
      <view wx:if="{{fishText}}" class="info-row">
        <text class="info-label">鱼种</text>
        <text class="info-value">{{fishText}}</text>
      </view>
    </view>

    <view wx:if="{{spot.description}}" class="section card">
      <view class="section-title">钓点简介</view>
      <text class="section-text">{{spot.description}}</text>
    </view>
    <view wx:if="{{spot.tips}}" class="section card">
      <view class="section-title">注意事项</view>
      <text class="section-text">{{spot.tips}}</text>
    </view>

    <view class="verified-line">{{verifiedText}}</view>

    <view wx:if="{{ugcVisible}}" class="section card ugc-section">
      <view class="ugc-head">
        <view class="ugc-title-wrap">
          <text class="section-title">钓点情报</text>
          <text wx:if="{{reportTotal > 0}}" class="ugc-total">{{reportTotal}} 条</text>
        </view>
        <button class="ugc-write" bindtap="openWrite">写一条</button>
      </view>

      <scroll-view scroll-x class="ugc-filters" enhanced show-scrollbar="{{false}}">
        <view
          wx:for="{{reportFilters}}"
          wx:key="key"
          class="ugc-filter {{reportFilter === item.key ? 'is-active' : ''}}"
          data-key="{{item.key}}"
          bindtap="changeReportFilter"
        >{{item.label}}</view>
      </scroll-view>

      <view wx:if="{{reportsLoading}}" class="ugc-skeletons">
        <view wx:for="{{[1, 2]}}" wx:key="*this" class="ugc-skeleton">
          <view class="ugc-skeleton-line ugc-skeleton-meta"></view>
          <view class="ugc-skeleton-line ugc-skeleton-body"></view>
          <view class="ugc-skeleton-line ugc-skeleton-body ugc-skeleton-short"></view>
        </view>
      </view>

      <view wx:elif="{{reportsError && reports.length === 0}}" class="ugc-state">
        <text class="ugc-state-text">{{reportsError}}</text>
        <button class="secondary-button ugc-retry" bindtap="retryReports">重试</button>
      </view>

      <view wx:elif="{{reports.length === 0}}" class="ugc-state">
        <text class="ugc-state-text">还没有人发布内容，来写第一条吧</text>
      </view>

      <block wx:else>
        <view wx:for="{{reports}}" wx:key="report_id" class="ugc-card">
          <view class="ugc-card-head">
            <text class="ugc-author">{{item.authorText}}</text>
            <view class="ugc-card-meta">
              <text wx:if="{{item.adopted}}" class="tag">运营已采纳</text>
              <text class="tag tag-soft">{{item.typeLabel}}</text>
              <text class="ugc-time">{{item.timeText}}</text>
            </view>
          </view>
          <text class="ugc-content">{{item.content}}</text>
          <text wx:if="{{item.catchText}}" class="ugc-catch">{{item.catchText}}</text>
          <view
            wx:if="{{item.images.length}}"
            class="ugc-image-grid {{item.images.length === 1 ? 'cols-1' : (item.images.length >= 4 ? 'cols-3' : '')}}"
          >
            <image
              wx:for="{{item.images}}"
              wx:for-item="imageUrl"
              wx:for-index="imageIndex"
              wx:key="*this"
              class="ugc-image-thumb"
              src="{{imageUrl}}"
              mode="aspectFill"
              lazy-load
              data-id="{{item.report_id}}"
              data-index="{{imageIndex}}"
              bindtap="previewReportImage"
            />
          </view>
          <view class="ugc-card-foot">
            <view
              class="ugc-like {{item.liked ? 'is-liked' : ''}}"
              data-id="{{item.report_id}}"
              bindtap="toggleLike"
            >
              <text class="ugc-like-icon">{{item.liked ? '♥' : '♡'}}</text>
              <text wx:if="{{item.likeCount > 0}}" class="ugc-like-count">{{item.likeCount}}</text>
            </view>
            <view class="ugc-menu" data-id="{{item.report_id}}" bindtap="openReportMenu">···</view>
          </view>
        </view>

        <view wx:if="{{reportsError}}" class="ugc-more-error">
          <text class="muted">{{reportsError}}</text>
          <text class="ugc-retry-link" bindtap="retryReports">重试</text>
        </view>

        <button
          wx:if="{{reportHasMore}}"
          class="secondary-button ugc-more"
          bindtap="loadMoreReports"
        >{{reportsLoadingMore ? '正在加载' : '加载更多'}}</button>
        <view wx:elif="{{reports.length > 0}}" class="ugc-end">已经到底了</view>
      </block>
    </view>

    <view class="section card">
      <view class="section-title">周边配套</view>
      <view wx:if="{{poiGroups.length}}" class="poi-groups">
        <view
          wx:for="{{poiGroups}}"
          wx:key="poi_type"
          class="poi-group"
          data-type="{{item.poi_type}}"
          bindtap="openPoiList"
        >
          <view class="poi-head">
            <text class="poi-label">{{item.label}}</text>
            <view class="poi-head-meta">
              <text class="poi-count">{{item.count}} 个</text>
              <text class="poi-more">查看 ›</text>
            </view>
          </view>
          <text class="poi-names">{{item.names}}</text>
        </view>
      </view>
      <view wx:else class="muted poi-empty">附近暂未收录，后续可通过用户上报补充</view>
    </view>
  </view>

  <view class="action-bar">
    <button class="secondary-button" bindtap="copyAddress">复制地址</button>
    <button wx:if="{{canNavigate}}" class="primary-button nav-button" bindtap="navigate">导航</button>
  </view>
</view>

<view
  wx:if="{{loginSheetOpen}}"
  class="ugc-mask"
  bindtap="closeLoginSheet"
  catchtouchmove="noop"
>
  <view class="ugc-sheet" catchtap="noop">
    <text class="ugc-sheet-title">登录后发布</text>
    <text class="ugc-sheet-text">登录后可以发布评论、鱼获和情报，与其他钓友交流。</text>
    <text class="ugc-sheet-text">登录仅获取微信身份标识，不读取昵称、头像和手机号。</text>
    <button
      class="primary-button ugc-sheet-button"
      bindtap="loginAndWrite"
      loading="{{loggingIn}}"
      disabled="{{loggingIn}}"
    >{{loggingIn ? '正在登录' : '微信登录'}}</button>
    <button
      class="secondary-button ugc-sheet-cancel"
      bindtap="closeLoginSheet"
      disabled="{{loggingIn}}"
    >取消</button>
  </view>
</view>
