.detail-page {
  min-height: 100vh;
  padding-bottom: 150rpx;
  background: #edf1ec;
}

.gallery {
  background: #dfe5e2;
}

.gallery-swiper {
  height: 440rpx;
}

.gallery-image {
  width: 100%;
  height: 440rpx;
}

.detail-body {
  padding: 28rpx 24rpx 0;
}

.detail-heading {
  padding: 4rpx 4rpx 26rpx;
}

.detail-title {
  display: block;
  color: #13211c;
  font-size: 46rpx;
  line-height: 1.2;
  font-weight: 700;
  letter-spacing: -0.035em;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 16rpx;
}

.tag-core {
  background: #fbe9e1;
  color: #b2412a;
}

.alert {
  margin-bottom: 16rpx;
  padding: 20rpx 22rpx;
  border-radius: 12rpx;
  font-size: 25rpx;
  line-height: 1.6;
}

.alert-danger {
  background: #fbe7e1;
  color: #b2412a;
}

.alert-warn {
  background: #fff1dc;
  color: #8a5a00;
}

.map-preview {
  overflow: hidden;
  margin-bottom: 16rpx;
}

.map-preview-map {
  width: 100%;
  height: 300rpx;
}

.info-card,
.section {
  margin-bottom: 16rpx;
  padding: 24rpx;
}

.info-row {
  display: flex;
  gap: 22rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #e7ede8;
  font-size: 26rpx;
  line-height: 1.55;
}

.info-row:last-child {
  border-bottom: 0;
}

.info-label {
  flex: 0 0 110rpx;
  color: #7a8782;
}

.info-value {
  flex: 1;
  min-width: 0;
  color: #13211c;
}

.section-title {
  margin-bottom: 12rpx;
}

.section-text {
  color: #4c5b55;
  font-size: 26rpx;
  line-height: 1.75;
}

.verified-line {
  padding: 6rpx 8rpx 22rpx;
  color: #7a8782;
  font-size: 23rpx;
}

.poi-groups {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.poi-group {
  padding: 16rpx;
  border-radius: 12rpx;
  background: #f2f5f0;
}

.poi-head {
  display: flex;
  justify-content: space-between;
  font-size: 25rpx;
  color: #13211c;
}

.poi-head-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.poi-count {
  color: #0e6b5e;
}

.poi-more {
  color: #8a9691;
  font-size: 22rpx;
}

.poi-names {
  display: block;
  margin-top: 6rpx;
  color: #5e6b66;
  font-size: 23rpx;
  line-height: 1.55;
}

.poi-empty {
  font-size: 24rpx;
}

.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 16rpx;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #fbfcf8;
  border-top: 1rpx solid #d7e0d9;
}

.secondary-button {
  flex: 0 0 220rpx;
  border: 1rpx solid #cfdcd4;
  border-radius: 12rpx;
  background: #fbfcf8;
  color: #13211c;
  font-size: 27rpx;
}

.secondary-button::after {
  border: 0;
}

.nav-button {
  flex: 1;
  font-size: 28rpx;
}

.detail-retry {
  margin-top: 24rpx;
}
