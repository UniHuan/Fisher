.detail-page {
  min-height: 100vh;
  padding-bottom: 150rpx;
  background: #EDF1EA;
}

.gallery {
  background: #E1E6DE;
}

.gallery-swiper {
  height: 440rpx;
}

.gallery-image {
  width: 100%;
  height: 440rpx;
}

.gallery-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 440rpx;
  background: #F5F4EE;
}

.gallery-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
}

.gallery-placeholder-mark {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #123B32;
  color: #F5F4EE;
  font-size: 34rpx;
  font-weight: 600;
  line-height: 88rpx;
  text-align: center;
}

.gallery-placeholder-text {
  color: #1E6B57;
  font-size: 24rpx;
  letter-spacing: 0.12em;
}

.gallery-placeholder-hint {
  color: #1E6B57;
  font-size: 24rpx;
}

.detail-body {
  padding: 28rpx 24rpx 0;
}

.detail-heading {
  padding: 4rpx 4rpx 26rpx;
}

.detail-title {
  display: block;
  color: #1B2420;
  font-size: 46rpx;
  line-height: 1.2;
  font-weight: 700;
  letter-spacing: -0.035em;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 16rpx;
}

.tag-core {
  background: #FAE7E2;
  color: #A93226;
}

.heading-feedback {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-top: 18rpx;
  color: #5C6B64;
  font-size: 24rpx;
}

.heading-feedback-link {
  color: #1E6B57;
  font-weight: 600;
}

.condition-card {
  margin-top: 20rpx;
  padding: 22rpx 24rpx;
}

.condition-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.condition-title {
  color: #1B2420;
  font-size: 30rpx;
  font-weight: 600;
}

.condition-time {
  color: #5C6B64;
  font-size: 24rpx;
}

.condition-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
}

.condition-meta {
  display: block;
  margin-top: 12rpx;
  color: #5C6B64;
  font-size: 24rpx;
  line-height: 1.5;
}

.condition-empty {
  display: block;
  margin-top: 12rpx;
  color: #5C6B64;
  font-size: 26rpx;
  line-height: 1.6;
}

.condition-button {
  margin-top: 16rpx;
  width: 220rpx;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 26rpx;
}

.alert {
  margin-bottom: 16rpx;
  padding: 20rpx 22rpx;
  border-radius: 12rpx;
  font-size: 25rpx;
  line-height: 1.6;
}

.alert-danger {
  background: #FAE7E2;
  color: #A93226;
}

.alert-warn {
  background: #F7EEE4;
  color: #7A5538;
}

.map-preview {
  overflow: hidden;
  margin-bottom: 16rpx;
}

.map-preview-map {
  width: 100%;
  height: 300rpx;
}

.info-card,
.section {
  margin-bottom: 16rpx;
  padding: 24rpx;
}

.info-row {
  display: flex;
  gap: 22rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #E3E8E1;
  font-size: 26rpx;
  line-height: 1.55;
}

.info-row:last-child {
  border-bottom: 0;
}

.info-label {
  flex: 0 0 110rpx;
  color: #5C6B64;
}

.info-value {
  flex: 1;
  min-width: 0;
  color: #1B2420;
}

.section-title {
  margin-bottom: 12rpx;
}

.section-text {
  color: #4C5B54;
  font-size: 26rpx;
  line-height: 1.75;
}

.verified-line {
  padding: 6rpx 8rpx 22rpx;
  color: #5C6B64;
  font-size: 24rpx;
}

.poi-groups {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.poi-group {
  padding: 16rpx;
  border-radius: 12rpx;
  background: #F2F5EF;
}

.poi-head {
  display: flex;
  justify-content: space-between;
  font-size: 25rpx;
  color: #1B2420;
}

.poi-head-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.poi-count {
  color: #1E6B57;
}

.poi-more {
  color: #5C6B64;
  font-size: 24rpx;
}

.poi-names {
  display: block;
  margin-top: 6rpx;
  color: #5C6B64;
  font-size: 24rpx;
  line-height: 1.55;
  word-break: break-word;
}

.poi-empty {
  font-size: 24rpx;
}

.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 16rpx;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: #F5F4EE;
  border-top: 1rpx solid #D8DFD8;
}

.secondary-button {
  flex: 0 0 220rpx;
  border: 1rpx solid #D2DAD2;
  border-radius: 12rpx;
  background: #F5F4EE;
  color: #1B2420;
  font-size: 27rpx;
}

.secondary-button::after {
  border: 0;
}

.nav-button {
  flex: 1;
  font-size: 28rpx;
}

.detail-retry {
  margin-top: 24rpx;
}

.product-section {
  padding-top: 26rpx;
}

.product-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.product-more {
  flex-shrink: 0;
  color: #1E6B57;
  font-size: 24rpx;
}

.product-rail {
  margin-top: 18rpx;
  white-space: nowrap;
}

.product-rail-item {
  display: inline-block;
  width: 280rpx;
  margin-right: 16rpx;
  vertical-align: top;
  white-space: normal;
}

.product-rail-item:last-child {
  margin-right: 0;
}

.product-note {
  display: block;
  margin-top: 14rpx;
  color: #5C6B64;
  font-size: 24rpx;
}

.ugc-section {
  padding-top: 26rpx;
}

.ugc-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.ugc-title-wrap {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.ugc-total {
  color: #5C6B64;
  font-size: 24rpx;
}

.ugc-write {
  margin: 0;
  padding: 0 22rpx;
  height: 52rpx;
  line-height: 52rpx;
  border-radius: 10rpx;
  background: #1E6B57;
  color: #ffffff;
  font-size: 24rpx;
}

.ugc-write::after {
  border: 0;
}

.ugc-filters {
  margin: 18rpx 0 6rpx;
  white-space: nowrap;
}

.ugc-filter {
  display: inline-flex;
  padding: 8rpx 20rpx;
  margin-right: 12rpx;
  border-radius: 999rpx;
  background: #EEF2EC;
  color: #5C6B64;
  font-size: 24rpx;
}

.ugc-filter.is-active {
  background: #1E6B57;
  color: #ffffff;
}

.ugc-skeletons {
  padding-top: 10rpx;
}

.ugc-skeleton {
  padding: 18rpx 0;
  border-top: 1rpx solid #E3E8E1;
}

.ugc-skeleton-line {
  height: 20rpx;
  margin-bottom: 12rpx;
  border-radius: 6rpx;
  background: #E3E8E1;
  animation: ugc-pulse 1.2s ease-in-out infinite;
}

.ugc-skeleton-meta {
  width: 38%;
}

.ugc-skeleton-body {
  width: 96%;
  height: 24rpx;
}

.ugc-skeleton-short {
  width: 62%;
}

@keyframes ugc-pulse {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0.55;
  }
}

.ugc-state {
  padding: 44rpx 20rpx;
  text-align: center;
}

.ugc-state-text {
  display: block;
  color: #5C6B64;
  font-size: 25rpx;
  line-height: 1.6;
}

.ugc-retry {
  width: 200rpx;
  margin-top: 18rpx;
  font-size: 24rpx;
}

.ugc-card {
  padding: 20rpx 0;
  border-top: 1rpx solid #E3E8E1;
}

.ugc-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.ugc-author {
  color: #1B2420;
  font-size: 25rpx;
  font-weight: 600;
}

.ugc-card-meta {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.ugc-time {
  color: #5C6B64;
  font-size: 24rpx;
}

.ugc-content {
  display: block;
  margin-top: 10rpx;
  color: #4C5B54;
  font-size: 27rpx;
  line-height: 1.7;
  word-break: break-word;
}

.ugc-catch {
  display: block;
  margin-top: 8rpx;
  color: #1E6B57;
  font-size: 24rpx;
}

.ugc-card-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
}

.ugc-more-error {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 14rpx 4rpx 0;
  font-size: 24rpx;
}

.ugc-retry-link {
  color: #1E6B57;
}

.ugc-more {
  margin-top: 18rpx;
  font-size: 25rpx;
}

.ugc-end {
  padding: 18rpx 0 4rpx;
  text-align: center;
  color: #5C6B64;
  font-size: 24rpx;
}

.ugc-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 50;
  display: flex;
  align-items: flex-end;
  background: rgba(11, 43, 38, 0.45);
}

.ugc-sheet {
  width: 100%;
  padding: 32rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 20rpx 20rpx 0 0;
  background: #F5F4EE;
}

.ugc-sheet-title {
  display: block;
  color: #1B2420;
  font-size: 32rpx;
  font-weight: 600;
}

.ugc-sheet-text {
  display: block;
  margin-top: 14rpx;
  color: #5C6B64;
  font-size: 25rpx;
  line-height: 1.65;
}

.ugc-sheet-button {
  margin-top: 28rpx;
  font-size: 28rpx;
}

.ugc-sheet-cancel {
  margin-top: 14rpx;
  font-size: 26rpx;
}
