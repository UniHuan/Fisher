.map-page {
  min-height: 100vh;
  background: #EDF1EA;
}

.map-wrap {
  position: relative;
  height: 64vh;
  background: #E1E6DE;
}

.map {
  width: 100%;
  height: 100%;
}

.map-locate {
  position: absolute;
  right: 28rpx;
  top: 28rpx;
  padding: 14rpx 24rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #1E6B57;
  font-size: 24rpx;
  box-shadow: 0 8rpx 22rpx rgba(11, 43, 38, 0.14);
}

.map-hint {
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  bottom: 28rpx;
  padding: 18rpx 22rpx;
  border-radius: 12rpx;
  background: rgba(11, 43, 38, 0.86);
  color: #ffffff;
  font-size: 24rpx;
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.map-error {
  background: rgba(178, 65, 42, 0.94);
}

.map-retry {
  text-decoration: underline;
}

.map-card {
  display: flex;
  gap: 20rpx;
  margin: 20rpx 24rpx;
  padding: 24rpx;
}

.map-cover {
  flex: 0 0 200rpx;
  width: 200rpx;
  height: 150rpx;
  border-radius: 12rpx;
  background: #E3E8E1;
}

.map-card-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.map-card-title {
  color: #1B2420;
  font-size: 31rpx;
  font-weight: 600;
  line-height: 1.35;
}

.map-card-meta {
  color: #5C6B64;
  font-size: 24rpx;
}

.map-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.map-detail-button {
  margin-top: 10rpx;
  width: 200rpx;
  height: 64rpx;
  line-height: 64rpx;
  font-size: 25rpx;
}

.map-empty {
  margin: 20rpx 24rpx;
  padding: 30rpx;
  background: #F5F4EE;
  border: 1rpx solid #D8DFD8;
  border-radius: 16rpx;
  color: #5C6B64;
  font-size: 25rpx;
  line-height: 1.6;
  text-align: center;
}
