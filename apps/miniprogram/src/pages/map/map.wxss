.map-page {
  min-height: 100vh;
  background: #f0f3f1;
}

.map-wrap {
  position: relative;
  height: 66vh;
  background: #dfe5e2;
}

.map {
  width: 100%;
  height: 100%;
}

.map-locate {
  position: absolute;
  right: 28rpx;
  top: 28rpx;
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  background: #ffffff;
  color: #0f6b5c;
  font-size: 24rpx;
  box-shadow: 0 8rpx 22rpx rgba(23, 33, 30, 0.14);
}

.map-hint {
  position: absolute;
  left: 28rpx;
  right: 28rpx;
  bottom: 28rpx;
  padding: 18rpx 22rpx;
  border-radius: 8rpx;
  background: rgba(23, 33, 30, 0.84);
  color: #ffffff;
  font-size: 24rpx;
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
}

.map-error {
  background: rgba(163, 58, 44, 0.92);
}

.map-retry {
  text-decoration: underline;
}

.map-card {
  display: flex;
  gap: 20rpx;
  margin: 22rpx 24rpx;
  padding: 18rpx;
}

.map-cover {
  width: 200rpx;
  height: 150rpx;
  border-radius: 8rpx;
  background: #eef1ef;
}

.map-cover-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9aa5a1;
  font-size: 22rpx;
}

.map-card-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.map-card-title {
  font-size: 30rpx;
  font-weight: 600;
}

.map-card-meta {
  color: #68736f;
  font-size: 24rpx;
}

.map-tags {
  display: flex;
  gap: 8rpx;
}

.map-detail-button {
  margin-top: 6rpx;
  font-size: 25rpx;
  line-height: 64rpx;
}

.map-empty {
  margin: 22rpx 24rpx;
  padding: 30rpx;
  color: #68736f;
  font-size: 25rpx;
  text-align: center;
}
