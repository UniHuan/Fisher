.index-page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.hero {
  padding: 34rpx 32rpx 104rpx;
  background: #123B32;
  display: flex;
  flex-direction: column;
}

.hero-kicker {
  color: #8FB8A6;
  font-size: 22rpx;
  line-height: 1.4;
}

.hero-title {
  margin-top: 14rpx;
  color: #ffffff;
  font-size: 60rpx;
  line-height: 1.1;
  font-weight: 700;
  letter-spacing: -0.04em;
}

.hero-sub {
  margin-top: 16rpx;
  max-width: 600rpx;
  color: #B9C9C0;
  font-size: 25rpx;
  line-height: 1.65;
}

.content {
  padding: 0 24rpx;
}

.search-wrap {
  position: relative;
  z-index: 2;
  margin-top: -58rpx;
}

.search-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 20rpx 22rpx;
  background: #ffffff;
  border: 0;
  border-radius: 16rpx;
  box-shadow: 0 12rpx 32rpx rgba(11, 43, 38, 0.16);
}

.search-icon {
  flex: 0 0 auto;
}

.search-input {
  flex: 1;
  min-width: 0;
  height: 44rpx;
  color: #1B2420;
  font-size: 28rpx;
}

.search-placeholder {
  color: #6B7772;
}

.search-clear {
  flex: 0 0 auto;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #6B7772;
  font-size: 30rpx;
  line-height: 1;
}

.filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 20rpx 0 8rpx;
}

.filter-pill {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 22rpx;
  border: 1rpx solid #D8DFD8;
  border-radius: 999rpx;
  background: #F5F4EE;
  color: #4C5B54;
  font-size: 24rpx;
  line-height: 1.2;
}

.pill-caret {
  color: #6B7772;
  font-size: 18rpx;
}

.filter-pill-active {
  border-color: #1E6B57;
  background: #E3EEE6;
  color: #1E6B57;
  font-weight: 600;
}

.filter-count {
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: #1E6B57;
  color: #ffffff;
  font-size: 18rpx;
  line-height: 30rpx;
  text-align: center;
}

.filter-pill-location {
  color: #1E6B57;
  border-color: #CBDCD3;
}

.result-meta {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 14rpx 4rpx 18rpx;
}

.result-count {
  color: #1B2420;
  font-size: 24rpx;
  font-weight: 600;
}

.result-sort {
  color: #6B7772;
  font-size: 23rpx;
}

.spot-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.spot-card {
  overflow: hidden;
}

.spot-cover {
  display: block;
  width: 100%;
  height: 300rpx;
  background: #E3E8E1;
}

.spot-cover-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  background: #F5F4EE;
  border-bottom: 1rpx solid #E3EEE6;
}

.spot-cover-mark {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #123B32;
  color: #F5F4EE;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 72rpx;
  text-align: center;
}

.spot-cover-text {
  color: #1E6B57;
  font-size: 23rpx;
  letter-spacing: 0.12em;
}

.spot-body {
  padding: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.spot-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.spot-name {
  flex: 1;
  min-width: 0;
  color: #1B2420;
  font-size: 31rpx;
  font-weight: 600;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.core-badge {
  flex: 0 0 auto;
  padding: 4rpx 10rpx;
  border-radius: 4rpx;
  background: #FAE7E2;
  color: #A93226;
  font-size: 20rpx;
  line-height: 1.4;
}

.spot-sub {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16rpx;
}

.spot-district {
  color: #5C6B64;
  font-size: 24rpx;
}

.spot-distance {
  color: #1E6B57;
  font-size: 24rpx;
  font-weight: 600;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 4rpx;
}

.freshness {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 4rpx;
  font-size: 22rpx;
}

.freshness-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
}

.freshness.tag-warn {
  background: transparent;
  padding: 0;
  color: #7A5538;
}

.freshness.tag-warn .freshness-dot {
  background: #7A5538;
}

.freshness.tag-danger {
  background: transparent;
  padding: 0;
  color: #A93226;
}

.freshness.tag-danger .freshness-dot {
  background: #A93226;
}

.load-more {
  padding: 28rpx;
  text-align: center;
  color: #6B7772;
  font-size: 24rpx;
}

.state-card {
  padding: 40rpx 32rpx;
  background: #F5F4EE;
  border: 1rpx solid #D8DFD8;
  border-radius: 16rpx;
}

.state-title {
  display: block;
  color: #1B2420;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.4;
}

.state-text {
  display: block;
  margin-top: 10rpx;
  color: #5C6B64;
  font-size: 25rpx;
  line-height: 1.65;
}

.state-button {
  margin-top: 26rpx;
  width: 220rpx;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 26rpx;
}

.skeleton-card {
  padding: 24rpx;
  background: #F5F4EE;
  border: 1rpx solid #D8DFD8;
  border-radius: 16rpx;
}

.skeleton-line,
.skeleton-chip {
  background: #E3E8E1;
  border-radius: 6rpx;
  animation: skeleton-pulse 1.4s ease-in-out infinite;
}

.skeleton-title {
  width: 58%;
  height: 30rpx;
}

.skeleton-meta {
  width: 36%;
  height: 22rpx;
  margin-top: 16rpx;
}

.skeleton-tags {
  display: flex;
  gap: 10rpx;
  margin-top: 18rpx;
}

.skeleton-chip {
  width: 92rpx;
  height: 30rpx;
}

@keyframes skeleton-pulse {
  0%,
  100% {
    opacity: 0.55;
  }
  50% {
    opacity: 1;
  }
}

.filter-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 50;
  display: flex;
  align-items: flex-end;
  background: rgba(11, 43, 38, 0.5);
}

.filter-sheet {
  width: 100%;
  max-height: 84vh;
  display: flex;
  flex-direction: column;
  padding: 28rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  border-radius: 24rpx 24rpx 0 0;
  background: #F5F4EE;
  animation: sheet-up 220ms cubic-bezier(0.22, 1, 0.36, 1);
}

@keyframes sheet-up {
  from {
    transform: translateY(24rpx);
    opacity: 0.6;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.filter-sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 18rpx;
}

.filter-sheet-title {
  color: #1B2420;
  font-size: 32rpx;
  font-weight: 600;
}

.filter-sheet-close {
  padding: 6rpx 0 6rpx 20rpx;
  color: #5C6B64;
  font-size: 25rpx;
}

.filter-sheet-scroll {
  height: 56vh;
  flex: 1;
}

.filter-section {
  padding: 16rpx 0 10rpx;
}

.filter-section-title {
  display: block;
  margin-bottom: 14rpx;
  color: #5C6B64;
  font-size: 24rpx;
  font-weight: 600;
}

.filter-options {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.filter-chip {
  padding: 12rpx 24rpx;
  border: 1rpx solid #D8DFD8;
  border-radius: 999rpx;
  background: #ffffff;
  color: #4C5B54;
  font-size: 24rpx;
  line-height: 1.2;
}

.filter-chip.is-active {
  border-color: #1E6B57;
  background: #1E6B57;
  color: #ffffff;
}

.filter-switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 6rpx 0;
}

.filter-switch-copy {
  flex: 1;
  min-width: 0;
}

.filter-switch-label {
  display: block;
  color: #1B2420;
  font-size: 26rpx;
}

.filter-switch-hint {
  display: block;
  margin-top: 4rpx;
  color: #6B7772;
  font-size: 22rpx;
  line-height: 1.5;
}

.filter-empty {
  padding: 30rpx 0;
  color: #6B7772;
  font-size: 24rpx;
}

.filter-sheet-actions {
  display: flex;
  gap: 16rpx;
  padding-top: 16rpx;
}

.filter-reset {
  flex: 0 0 180rpx;
  height: 88rpx;
  line-height: 88rpx;
  border: 1rpx solid #D2DAD2;
  border-radius: 12rpx;
  background: #F5F4EE;
  color: #1B2420;
  font-size: 27rpx;
}

.filter-reset::after {
  border: 0;
}

.filter-apply {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
}
