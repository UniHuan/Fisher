.hero {
  padding: 18rpx 8rpx 28rpx;
  display: flex;
  flex-direction: column;
}

.hero-kicker {
  color: #0f6b5c;
  font-size: 22rpx;
  letter-spacing: 0.12em;
}

.hero-title {
  margin-top: 10rpx;
  font-size: 54rpx;
  line-height: 1.1;
  font-weight: 600;
  letter-spacing: -0.04em;
}

.hero-sub {
  margin-top: 14rpx;
  max-width: 560rpx;
  color: #68736f;
  font-size: 25rpx;
  line-height: 1.65;
}

.search-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 18rpx 20rpx;
}

.search-mark {
  width: 38rpx;
  height: 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 4rpx;
  background: #e7f1ee;
  color: #0f6b5c;
  font-size: 20rpx;
}

.search-input {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
}

.search-placeholder {
  color: #9aa5a1;
}

.filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 18rpx 0 8rpx;
}

.filter-pill {
  padding: 12rpx 20rpx;
  border: 1rpx solid #dfe5e2;
  border-radius: 999rpx;
  background: #ffffff;
  color: #4b5854;
  font-size: 24rpx;
  line-height: 1.2;
}

.switch-pill {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.switch-pill switch {
  transform: scale(0.75);
}

.location-pill {
  color: #0f6b5c;
  border-color: #c9dfd9;
  background: #e7f1ee;
}

.result-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 8rpx 18rpx;
  font-size: 24rpx;
  color: #4b5854;
}

.spot-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.spot-card {
  display: flex;
  gap: 18rpx;
  padding: 16rpx;
}

.spot-cover {
  flex: 0 0 210rpx;
  width: 210rpx;
  height: 158rpx;
  border-radius: 8rpx;
  background: #eef1ef;
}

.spot-cover-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #9aa5a1;
  font-size: 22rpx;
}

.spot-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.spot-top {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.spot-name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.spot-meta {
  color: #68736f;
  font-size: 24rpx;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.freshness {
  font-size: 22rpx;
  padding: 4rpx 0;
}

.freshness.tag-warn {
  color: #8a5a00;
}

.freshness.tag-danger {
  color: #a33a2c;
}

.load-more {
  padding: 28rpx;
  text-align: center;
  color: #9aa5a1;
  font-size: 24rpx;
}

.retry-button {
  margin-top: 24rpx;
  font-size: 26rpx;
}

.filter-trigger {
  color: #0f6b5c;
  border-color: #c9dfd9;
}

.filter-trigger-active {
  background: #e7f1ee;
  font-weight: 600;
}

.filter-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 50;
  display: flex;
  align-items: flex-end;
  background: rgba(23, 33, 30, 0.42);
}

.filter-sheet {
  width: 100%;
  max-height: 84vh;
  display: flex;
  flex-direction: column;
  padding: 28rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));
  border-radius: 20rpx 20rpx 0 0;
  background: #f7f9f8;
}

.filter-sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-bottom: 18rpx;
}

.filter-sheet-title {
  font-size: 32rpx;
  font-weight: 600;
}

.filter-sheet-close {
  color: #68736f;
  font-size: 25rpx;
  padding: 6rpx 0 6rpx 20rpx;
}

.filter-sheet-scroll {
  height: 56vh;
  flex: 1;
}

.filter-section {
  padding: 16rpx 0 10rpx;
}

.filter-section-title {
  display: block;
  margin-bottom: 12rpx;
  color: #4b5854;
  font-size: 24rpx;
}

.filter-options {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.filter-chip {
  padding: 11rpx 22rpx;
  border: 1rpx solid #dfe5e2;
  border-radius: 999rpx;
  background: #ffffff;
  color: #4b5854;
  font-size: 24rpx;
}

.filter-chip.is-active {
  border-color: #0f6b5c;
  background: #e7f1ee;
  color: #0a3f38;
  font-weight: 600;
}

.filter-empty {
  padding: 40rpx 0;
  color: #9aa5a1;
  font-size: 24rpx;
  text-align: center;
}

.filter-sheet-actions {
  display: flex;
  gap: 16rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #dfe5e2;
}

.filter-reset {
  flex: 0 0 190rpx;
  border: 1rpx solid #c9dfd9;
  border-radius: 8rpx;
  background: #ffffff;
  color: #0f6b5c;
  font-size: 27rpx;
}

.filter-reset::after {
  border: 0;
}

.filter-apply {
  flex: 1;
  font-size: 28rpx;
}
