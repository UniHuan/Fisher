<view class="index-page">
  <view class="hero">
    <text class="hero-kicker">深圳海岸与水库</text>
    <text class="hero-title">今天去哪钓？</text>
    <text class="hero-sub">按区域、鱼种和距离找钓点，出发前先看核实时间。</text>
  </view>

  <view class="content">
    <view class="search-wrap">
      <view class="search-row card">
        <icon class="search-icon" type="search" size="16" color="#5C6B64"></icon>
        <input
          class="search-input"
          value="{{keyword}}"
          placeholder="搜钓点名称"
          placeholder-class="search-placeholder"
          confirm-type="search"
          bindinput="onKeywordInput"
          bindconfirm="onSearchSubmit"
        />
        <view wx:if="{{keyword}}" class="search-clear" catchtap="clearKeyword">×</view>
      </view>
    </view>

    <view class="filter-row">
      <picker mode="selector" range="{{districtLabels}}" value="{{districtIndex}}" bindchange="onDistrictChange">
        <view class="filter-pill">
          <text>{{districtLabels[districtIndex]}}</text>
          <text class="pill-caret">▾</text>
        </view>
      </picker>
      <view
        class="filter-pill {{filterCount > 0 ? 'filter-pill-active' : ''}}"
        bindtap="openFilters"
      >
        <text>筛选</text>
        <text wx:if="{{filterCount > 0}}" class="filter-count">{{filterCount}}</text>
      </view>
      <view class="filter-pill filter-pill-location" bindtap="onLocationAction">
        {{location ? '已定位' : locationDenied ? '去设置' : '显示距离'}}
      </view>
    </view>

    <view class="result-meta">
      <text class="result-count">{{initialized ? total + ' 个钓点' : '正在加载'}}</text>
      <text class="result-sort">{{location ? '按距离' : '按推荐'}}</text>
    </view>

    <view wx:if="{{error}}" class="state-card">
      <text class="state-title">钓点加载失败</text>
      <text class="state-text">{{error}}</text>
      <button class="primary-button state-button" bindtap="retry">重新加载</button>
    </view>

    <view wx:elif="{{loading && spots.length === 0}}" class="spot-list">
      <view class="skeleton-card" wx:for="{{skeletons}}" wx:key="*this">
        <view class="skeleton-line skeleton-title"></view>
        <view class="skeleton-line skeleton-meta"></view>
        <view class="skeleton-tags">
          <view class="skeleton-chip"></view>
          <view class="skeleton-chip"></view>
          <view class="skeleton-chip"></view>
        </view>
      </view>
    </view>

    <view wx:elif="{{initialized && spots.length === 0}}" class="state-card">
      <text class="state-title">没有符合条件的钓点</text>
      <text class="state-text">{{keyword ? '换个关键词，或清除筛选再试一次。' : '这个区域还没有收录的钓点，清除筛选看看全部。'}}</text>
      <button class="primary-button state-button" bindtap="resetFilters">清除筛选</button>
    </view>

    <view wx:else class="spot-list">
      <view
        class="spot-card card"
        hover-class="card-pressed"
        wx:for="{{spots}}"
        wx:key="spot_id"
        data-id="{{item.spot_id}}"
        data-index="{{index}}"
        bindtap="openDetail"
      >
        <image wx:if="{{item.cover}}" class="spot-cover" src="{{item.cover}}" mode="aspectFill" />
        <view wx:else class="spot-cover spot-cover-empty">
          <view class="spot-cover-mark">钓</view>
          <text class="spot-cover-text">实景图待补充</text>
        </view>
        <view class="spot-body">
          <view class="spot-head">
            <text class="spot-name">{{item.spot_name}}</text>
            <text wx:if="{{item.isCore}}" class="core-badge">核心</text>
          </view>
          <view class="spot-sub">
            <text class="spot-district">{{item.districtLabel}}</text>
            <text wx:if="{{item.distanceText}}" class="spot-distance">{{item.distanceText}}</text>
          </view>
          <view class="tag-row">
            <text class="tag">{{item.feeLabel}}</text>
            <text class="tag {{item.openTone || 'tag-line'}}">{{item.openLabel}}</text>
            <text
              wx:for="{{item.fishLabels}}"
              wx:key="*this"
              wx:for-item="fish"
              class="tag tag-soft"
            >{{fish}}</text>
          </view>
          <view wx:if="{{item.freshnessLabel}}" class="freshness {{item.freshnessTone}}">
            <text class="freshness-dot"></text>
            <text>{{item.freshnessLabel}}</text>
          </view>
        </view>
      </view>

      <view wx:if="{{loading}}" class="load-more">加载中…</view>
      <view wx:elif="{{!hasMore && spots.length > 0}}" class="load-more">没有更多了</view>
    </view>
  </view>

  <view
    wx:if="{{filterOpen}}"
    class="filter-mask"
    bindtap="closeFilters"
    catchtouchmove="noop"
  >
    <view class="filter-sheet" catchtap="noop">
      <view class="filter-sheet-head">
        <text class="filter-sheet-title">筛选钓点</text>
        <text class="filter-sheet-close" bindtap="closeFilters">关闭</text>
      </view>
      <scroll-view scroll-y class="filter-sheet-scroll">
        <view wx:if="{{fishOptions.length}}" class="filter-section">
          <text class="filter-section-title">鱼种</text>
          <view class="filter-options">
            <view
              wx:for="{{fishOptions}}"
              wx:key="key"
              class="filter-chip {{item.selected ? 'is-active' : ''}}"
              data-value="{{item.key}}"
              bindtap="toggleFish"
            >{{item.label}}</view>
          </view>
        </view>
        <view wx:if="{{feeOptions.length}}" class="filter-section">
          <text class="filter-section-title">收费</text>
          <view class="filter-options">
            <view
              wx:for="{{feeOptions}}"
              wx:key="key"
              class="filter-chip {{item.selected ? 'is-active' : ''}}"
              data-section="fee"
              data-value="{{item.key}}"
              bindtap="selectFilter"
            >{{item.label}}</view>
          </view>
        </view>
        <view wx:if="{{waterOptions.length}}" class="filter-section">
          <text class="filter-section-title">水域</text>
          <view class="filter-options">
            <view
              wx:for="{{waterOptions}}"
              wx:key="key"
              class="filter-chip {{item.selected ? 'is-active' : ''}}"
              data-section="water"
              data-value="{{item.key}}"
              bindtap="toggleMulti"
            >{{item.label}}</view>
          </view>
        </view>
        <view wx:if="{{venueOptions.length}}" class="filter-section">
          <text class="filter-section-title">场所</text>
          <view class="filter-options">
            <view
              wx:for="{{venueOptions}}"
              wx:key="key"
              class="filter-chip {{item.selected ? 'is-active' : ''}}"
              data-section="venue"
              data-value="{{item.key}}"
              bindtap="toggleMulti"
            >{{item.label}}</view>
          </view>
        </view>
        <view class="filter-section">
          <text class="filter-section-title">内容</text>
          <view class="filter-switch-row">
            <view class="filter-switch-copy">
              <text class="filter-switch-label">显示禁钓点</text>
              <text class="filter-switch-hint">默认隐藏，开启后显示禁钓提示</text>
            </view>
            <switch checked="{{includeBanned}}" color="#1E6B57" bindchange="onBannedChange" />
          </view>
        </view>
        <view wx:if="{{!fishOptions.length && !feeOptions.length}}" class="filter-empty">
          筛选项加载中，稍后再试
        </view>
      </scroll-view>
      <view class="filter-sheet-actions">
        <button class="filter-reset" bindtap="resetDraftFilters">重置</button>
        <button class="primary-button filter-apply" bindtap="applyFilters">查看钓点</button>
      </view>
    </view>
  </view>
</view>
