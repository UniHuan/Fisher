.product-card {
  overflow: hidden;
  background: #ffffff;
  border: 1rpx solid #D8DFD8;
  border-radius: 16rpx;
}

.product-card-cover {
  display: block;
  width: 100%;
  height: 220rpx;
  background: #E3E8E1;
}

.product-card-cover-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  background: #E3EEE6;
}

.product-card-mark {
  color: #1E6B57;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 0.12em;
}

.product-card-body {
  padding: 16rpx 18rpx 18rpx;
}

.product-card-title {
  display: block;
  overflow: hidden;
  color: #1B2420;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.4;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.product-card-subtitle {
  display: block;
  overflow: hidden;
  margin-top: 6rpx;
  color: #5C6B64;
  font-size: 22rpx;
  line-height: 1.45;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.product-card-foot {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 10rpx;
  margin-top: 14rpx;
}

.product-card-price {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  min-width: 0;
}

.product-card-price-label {
  flex-shrink: 0;
  color: #6B7772;
  font-size: 20rpx;
}

.product-card-price-value {
  overflow: hidden;
  color: #C0392B;
  font-size: 26rpx;
  font-weight: 600;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.product-card-channel {
  flex-shrink: 0;
  padding: 2rpx 10rpx;
  border-radius: 6rpx;
  background: #E3EEE6;
  color: #1E6B57;
  font-size: 20rpx;
  white-space: nowrap;
}
