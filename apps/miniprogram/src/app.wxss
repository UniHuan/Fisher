page {
  background: #EDF1EA;
  color: #1B2420;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Noto Sans SC", sans-serif;
}

view,
text,
button,
input {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 40rpx;
}

.card {
  background: #ffffff;
  border: 1rpx solid #D8DFD8;
  border-radius: 16rpx;
}

.muted {
  color: #5C6B64;
}

.tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 12rpx;
  border-radius: 6rpx;
  background: #E3EEE6;
  color: #1E6B57;
  font-size: 22rpx;
  line-height: 1.4;
}

.tag-soft {
  background: #EEF2EC;
  color: #5C6B64;
}

.tag-line {
  background: transparent;
  border: 1rpx solid #D2DAD2;
  color: #4C5B54;
}

.tag-warn {
  background: #F7EEE4;
  color: #7A5538;
}

.tag-danger {
  background: #FAE7E2;
  color: #A93226;
}

.empty {
  padding: 100rpx 36rpx;
  text-align: center;
  color: #5C6B64;
  font-size: 28rpx;
}

.primary-button {
  background: #1E6B57;
  color: #ffffff;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.primary-button::after {
  border: 0;
}

.secondary-button {
  background: #F5F4EE;
  color: #1B2420;
  border: 1rpx solid #D2DAD2;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.secondary-button::after {
  border: 0;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: -0.02em;
}

.card-pressed {
  opacity: 0.92;
}

.form-field {
  margin-bottom: 26rpx;
}

.form-label {
  display: block;
  margin-bottom: 12rpx;
  color: #1B2420;
  font-size: 26rpx;
  font-weight: 600;
}

.form-input {
  width: 100%;
  padding: 18rpx 20rpx;
  border: 1rpx solid #D8DFD8;
  border-radius: 10rpx;
  background: #F2F5EF;
  color: #1B2420;
  font-size: 27rpx;
}

.form-textarea {
  width: 100%;
  min-height: 240rpx;
  padding: 18rpx 20rpx;
  border: 1rpx solid #D8DFD8;
  border-radius: 10rpx;
  background: #F2F5EF;
  color: #1B2420;
  font-size: 27rpx;
  line-height: 1.6;
}

.form-counter {
  display: block;
  margin-top: 8rpx;
  text-align: right;
  color: #6B7772;
  font-size: 22rpx;
}

.form-hint {
  color: #6B7772;
  font-size: 23rpx;
  line-height: 1.5;
}

.form-error {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 10rpx;
  background: #FAE7E2;
  color: #A93226;
  font-size: 24rpx;
  line-height: 1.5;
}

.filter-chip {
  display: inline-flex;
  align-items: center;
  margin-right: 12rpx;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: #EEF2EC;
  color: #5C6B64;
  font-size: 24rpx;
  line-height: 1.3;
}

.filter-chip:last-child {
  margin-right: 0;
}

.filter-chip-active {
  background: #1E6B57;
  color: #ffffff;
}

.login-card {
  padding: 36rpx 28rpx;
  text-align: center;
}

.login-title {
  display: block;
  color: #1B2420;
  font-size: 32rpx;
  font-weight: 600;
}

.login-text {
  display: block;
  margin-top: 14rpx;
  color: #5C6B64;
  font-size: 25rpx;
  line-height: 1.6;
}

.login-button {
  margin-top: 28rpx;
}

.retry-button {
  margin-top: 24rpx;
}

.ugc-image-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 8rpx;
  margin-top: 12rpx;
}

.ugc-image-grid.cols-1 {
  grid-template-columns: 1fr;
}

.ugc-image-grid.cols-3 {
  grid-template-columns: repeat(3, 1fr);
}

.ugc-image-thumb {
  width: 100%;
  height: 200rpx;
  border-radius: 12rpx;
  background: #E3E8E1;
}

.ugc-image-grid.cols-1 .ugc-image-thumb {
  height: 340rpx;
}

.ugc-like {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 6rpx 0;
  color: #6B7772;
  font-size: 24rpx;
}

.ugc-like.is-liked {
  color: #C0392B;
}

.ugc-like-icon {
  font-size: 28rpx;
  line-height: 1;
}

.ugc-like-count {
  font-size: 23rpx;
}

.ugc-menu {
  padding: 6rpx 12rpx;
  color: #6B7772;
  font-size: 30rpx;
  line-height: 1;
  letter-spacing: 2rpx;
}
