# API origin including the /api/v1 prefix.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# Optional Tencent Maps JS key for the editor map picker. Restrict the key to
# the admin domain in the Tencent Location Service console. Rebuild the static
# admin after changing it.
NEXT_PUBLIC_TENCENT_MAP_JS_KEY=
