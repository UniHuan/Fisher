# Template for /etc/szfisher/production.env. Never commit the filled file.
# Staging should use a separate file and separate values.

API_IMAGE=registry.cn-shenzhen.aliyuncs.com/CHANGE_ME/szfisher-api:TAG
ADMIN_IMAGE=registry.cn-shenzhen.aliyuncs.com/CHANGE_ME/szfisher-admin:TAG
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/szfisher?schema=public&sslmode=require
ADMIN_ORIGINS=https://fish-admin.unihuan.com

# Generate each secret independently; never reuse the local placeholders.
JWT_ACCESS_SECRET=
CSRF_SECRET=
TOTP_ENCRYPTION_KEY=

STORAGE_DRIVER=oss
OSS_REGION=oss-cn-shenzhen
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_WORK_BUCKET=
OSS_PUBLIC_BUCKET=
OSS_PUBLIC_BASE_URL=https://fish-static.unihuan.com

TENCENT_MAP_SERVER_KEY=
LOG_LEVEL=info
