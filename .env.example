# Local development environment template.
# Copy to .env and fill the empty secrets. Never commit .env.

NODE_ENV=local
PORT=3001

# Local PostgreSQL. The Docker stack in infra/docker uses postgres as the host.
DATABASE_URL=postgresql://szfisher:szfisher@localhost:5432/szfisher?schema=public

# Local integration tests:
#   1. pnpm db:test:up        starts postgres:15 for szfisher_test on port 5432
#   2. pnpm test:integration  resets and seeds szfisher_test, then runs the e2e suite
# The test stack and `pnpm db:up` both bind port 5432, so do not run them alongside each other.

# Comma-separated origins allowed to call the admin API.
# HTTPS is required outside local; local may use http://localhost:<port>.
ADMIN_ORIGINS=http://localhost:3000

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=

# Generate with: openssl rand -base64 48
CSRF_SECRET=

# Generate with: openssl rand -base64 32
TOTP_ENCRYPTION_KEY=

STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage

# Required only when STORAGE_DRIVER=oss. Keep both buckets private.
# OSS_REGION=oss-cn-shenzhen
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
# OSS_WORK_BUCKET=
# OSS_PUBLIC_BUCKET=
# OSS_PUBLIC_BASE_URL=https://fish-static.unihuan.com

# Optional server-side key for POI sync; manual POI management works without it.
# Never expose this key to the admin web app or mini program.
# TENCENT_MAP_SERVER_KEY=

# Structured JSON log level: debug, info, warn or error. Defaults to info.
# LOG_LEVEL=info

# Analytics event retention used by the purge job.
# ANALYTICS_RETENTION_DAYS=180

# Optional bootstrap admin for `pnpm db:seed` (local and staging only).
SEED_ADMIN_USERNAME=admin
# Use at least 12 characters. Generate with: openssl rand -base64 24
SEED_ADMIN_PASSWORD=
